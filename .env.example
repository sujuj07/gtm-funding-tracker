# Required
GROQ_API_KEY=
WEBHOOK_URL=
WEBHOOK_TOKEN=

# Optional; direct X search is incomplete without suitable X API access.
X_BEARER_TOKEN=

# Optional; DeFiLlama's structured Raises API is a paid/API-plan endpoint.
DEFILLAMA_API_KEY=

# Optional RootData Basic API. Add this value as a GitHub Actions secret named ROOTDATA_API_KEY.
# Project search (/open/ser_inv) is documented as unlimited; /open/get_item costs 2 credits.
# Tracker caps its own detail use at 24 credits/day and 800 credits/month, preserving 200 account credits.
ROOTDATA_API_KEY=
ROOTDATA_MONTHLY_CREDIT_CAP=800
ROOTDATA_DAILY_CREDIT_CAP=24
ROOTDATA_RESERVE_CREDITS=200

# Optional. Smaller default first; router switches to the fallback list on 429/model errors.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODEL_FALLBACKS=qwen/qwen3.8-27b,openai/gpt-oss-120b
