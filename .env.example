# Required
GROQ_API_KEY=
WEBHOOK_URL=
WEBHOOK_TOKEN=

# Optional; direct X search is incomplete without suitable X API access.
X_BEARER_TOKEN=

# Optional; DeFiLlama's structured Raises API is a paid/API-plan endpoint.
DEFILLAMA_API_KEY=

# Optional. Smaller default first; router switches to the fallback list on 429/model errors.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODEL_FALLBACKS=qwen/qwen3.8-27b,openai/gpt-oss-120b
